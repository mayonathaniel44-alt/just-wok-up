
@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap");

:root {
  font-family: "DM Sans", sans-serif;
  color: #22231f;
  background: #f8f7f3;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  font-optical-sizing: auto;
  font-weight: 400;
  font-size: 14px;
  font-smooth: never;
  --ink: #22231f;
  --muted: #777970;
  --line: #e7e5dc;
  --paper: #fffefa;
  --accent: #d9f06b;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.app-shell {
  min-height: 100vh;
}

.topbar {
  height: 76px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1.5px solid var(--ink);
  border-radius: 50%;
  font-weight: 700;
  letter-spacing: -1px;
}

.brand strong,
.brand small {
  display: block;
}

.brand strong {
  font-size: 12px;
  letter-spacing: 2px;
}

.brand small {
  margin-top: 5px;
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 1.3px;
}

.cart-link {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
}

.cart-link span {
  min-width: 26px;
  height: 26px;
  padding: 0 7px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--accent);
}

main {
  width: min(1120px, 86%);
  margin: 0 auto;
}

.hero {
  padding: 82px 0 62px;
  border-bottom: 1px solid var(--line);
}

.eyebrow {
  margin: 0 0 15px;
  color: #666c52;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.hero h1,
.section-heading h2 {
  font-family: "Playfair Display", Georgia, serif;
  font-weight: 500;
}

.hero h1 {
  margin: 0;
  font-size: clamp(42px, 6vw, 70px);
  line-height: 1.08;
  letter-spacing: -2px;
}

.hero-copy {
  max-width: 420px;
  margin: 20px 0 26px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.8;
}

.hero-note {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #65675e;
  font-size: 11px;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #87a13c;
}

.preview-label {
  padding: 5px 8px;
  border: 1px solid var(--line);
  border-radius: 4px;
  font-size: 9px;
  letter-spacing: 1px;
}

.menu-section,
.order-section {
  padding: 52px 0;
  border-bottom: 1px solid var(--line);
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}

.section-heading .eyebrow {
  margin-bottom: 8px;
}

.section-heading h2 {
  margin: 0;
  font-size: 34px;
  letter-spacing: -0.8px;
}

.item-count {
  padding-bottom: 6px;
  color: var(--muted);
  font-size: 12px;
}

.search-input {
  width: 100%;
  padding: 15px 16px;
  border: 1px solid var(--line);
  border-radius: 8px;
  outline: none;
  background: var(--paper);
}

.search-input:focus,
textarea:focus {
  border-color: #858d61;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin: 19px 0 27px;
}

.category-button {
  padding: 10px 16px;
  border: 1px solid var(--line);
  border-radius: 99px;
  background: transparent;
  color: #5c5d55;
  font-size: 12px;
}

.category-button.active {
  background: var(--ink);
  border-color: var(--ink);
  color: white;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.menu-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--paper);
}

.dish-placeholder {
  position: relative;
  height: 155px;
  padding: 15px;
  display: flex;
  align-items: start;
  justify-content: space-between;
  background: #eeeee5;
  color: #646956;
  font-size: 10px;
}

.dish-placeholder > span:first-child {
  padding: 6px 9px;
  border: 1px solid #d8dacd;
  border-radius: 99px;
  background: #f8f8f1;
}

.dish-initial {
  position: absolute;
  right: 19px;
  bottom: -20px;
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  border: 4px solid var(--paper);
  border-radius: 50%;
  background: var(--accent);
  color: var(--ink);
  font-family: Georgia, serif;
  font-size: 22px;
}

.dish-info {
  padding: 20px;
}

.dish-category {
  margin: 0 0 7px;
  color: #777b64;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.dish-info h3 {
  margin: 0;
  font-size: 17px;
}

.dish-description {
  min-height: 38px;
  margin: 10px 0 18px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.dish-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.dish-footer > strong {
  font-size: 15px;
}

.add-button {
  padding: 9px 13px;
  border: 1px solid var(--ink);
  border-radius: 6px;
  background: var(--ink);
  color: white;
  font-size: 12px;
}

.add-button:hover {
  background: #45463f;
}

.message,
.error-message {
  padding: 18px 0;
  color: var(--muted);
}

.error-message {
  color: #a52e2e;
}

.order-section {
  max-width: 760px;
  margin: 0 auto;
}

.empty-cart {
  min-height: 185px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px dashed #d9d7cd;
  border-radius: 10px;
  text-align: center;
}

.empty-cart-icon {
  margin-bottom: 12px;
  color: #70745f;
  font-size: 30px;
}

.empty-cart p {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.cart-items {
  border-top: 1px solid var(--line);
}

.cart-item {
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 20px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}

.cart-item-info strong,
.cart-item-info span {
  display: block;
}

.cart-item-info span {
  margin-top: 6px;
  color: var(--muted);
  font-size: 11px;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 12px;
}

.quantity-controls button {
  width: 29px;
  height: 29px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: var(--paper);
}

.line-total {
  min-width: 90px;
  text-align: right;
}

.notes-label {
  display: block;
  margin: 24px 0 9px;
  font-weight: 600;
}

textarea {
  width: 100%;
  padding: 13px;
  resize: vertical;
  border: 1px solid var(--line);
  border-radius: 8px;
  outline: none;
  background: var(--paper);
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 25px;
  font-size: 15px;
}

.total-row strong {
  font-size: 22px;
}

.checkout-hint {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.6;
}

.checkout-button {
  width: 100%;
  margin-top: 12px;
  padding: 16px;
  border: none;
  border-radius: 7px;
  background: var(--accent);
  color: var(--ink);
  font-weight: 700;
}

.footer {
  padding: 38px 7%;
  text-align: center;
}

.footer > strong {
  font-size: 11px;
  letter-spacing: 2px;
}

.footer p {
  margin: 8px 0;
  color: var(--muted);
  font-family: Georgia, serif;
  font-style: italic;
}

.footer small {
  color: #96968d;
  font-size: 10px;
}

@media (max-width: 800px) {
  main {
    width: 90%;
  }

  .menu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .dish-info {
    padding: 15px;
  }

  .dish-placeholder {
    height: 130px;
  }
}

@media (max-width: 520px) {
  .topbar {
    height: 66px;
    padding: 0 5%;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
  }

  .brand strong {
    font-size: 10px;
  }

  .brand small {
    font-size: 8px;
  }

  .hero {
    padding: 58px 0 42px;
  }

  .hero h1 {
    font-size: 45px;
  }

  .section-heading h2 {
    font-size: 29px;
  }

  .menu-grid {
    grid-template-columns: 1fr;
  }

  .dish-placeholder {
    height: 150px;
  }

  .cart-item {
    grid-template-columns: 1fr auto;
    gap: 12px;
  }

  .line-total {
    grid-column: 1;
    text-align: left;
  }

  .quantity-controls {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
}
